<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : (typeof title !== 'undefined' ? title : 'Agent Portal') %> - E-Waste Pickup System</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="role-agent">
  <nav class="navbar">
    <div class="nav-container">
      <a href="/agent" class="brand-link">
        <span style="font-size: 1.4rem;">🚚</span>
        <span class="brand-title">EcoPickup</span>
        <span class="portal-tag">FIELD AGENT</span>
      </a>
      <ul class="nav-menu">
        <li>
          <a href="/agent" class="nav-link <%= (typeof activeNav !== 'undefined' && activeNav === 'dashboard') ? 'active' : '' %>">
            Dashboard
          </a>
        </li>
        <li>
          <a href="/agent/pickups" class="nav-link <%= (typeof activeNav !== 'undefined' && activeNav === 'pickups') ? 'active' : '' %>">
            Assigned Pickups
          </a>
        </li>
        <li>
          <span class="user-profile-badge">
            🛵 <%= (typeof user !== 'undefined' && user && user.name) ? user.name : 'Field Agent' %>
          </span>
        </li>
        <li><a href="/logout" class="btn-logout">Logout</a></li>
      </ul>
    </div>
  </nav>
