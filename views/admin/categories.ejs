<%- include('../partials/adminNav', { pageTitle: 'Item Categories', activeNav: 'categories' }) %>

<main class="main-content">
  <div class="dashboard-header">
    <div>
      <h1>Item Categories Catalogue</h1>
      <p>Configure recyclable e-waste categories and reward point rates per kilogram.</p>
    </div>
    <div>
      <a href="/admin/categories/add" class="btn-primary" style="text-decoration: none; padding: 0.65rem 1.25rem; width: auto;">
        + Add New Category
      </a>
    </div>
  </div>

  <div class="feature-card" style="padding: 1.5rem; overflow-x: auto;">
    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
      <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
          <tr style="border-bottom: 2px solid var(--slate-200); color: var(--slate-600); font-size: 0.85rem; text-transform: uppercase;">
            <th style="padding: 0.75rem 1rem;">Category Name</th>
            <th style="padding: 0.75rem 1rem;">Reward Rate</th>
            <th style="padding: 0.75rem 1rem;">Description</th>
            <th style="padding: 0.75rem 1rem; text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach(cat => { %>
            <tr style="border-bottom: 1px solid var(--slate-200); font-size: 0.95rem;">
              <td style="padding: 1rem;">
                <strong>🏷️ <%= cat.name %></strong>
              </td>
              <td style="padding: 1rem;">
                <span class="role-tag citizen" style="font-weight: 700; font-size: 0.85rem;">
                  ⭐ <%= cat.rewardPointsPerKg %> pts / kg
                </span>
              </td>
              <td style="padding: 1rem; color: var(--slate-600); max-width: 400px;">
                <%= cat.description || 'No description provided' %>
              </td>
              <td style="padding: 1rem; text-align: right;">
                <a href="/admin/categories/edit/<%= cat._id %>" class="btn-primary" style="text-decoration: none; padding: 0.4rem 0.85rem; font-size: 0.85rem; width: auto; display: inline-block;">
                  Edit Rate
                </a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <div style="text-align: center; padding: 3rem 1rem;">
        <p style="color: var(--slate-500); margin-bottom: 1rem;">No item categories found.</p>
        <a href="/admin/categories/add" class="btn-primary" style="display: inline-block; width: auto; padding: 0.75rem 1.5rem; text-decoration: none;">
          Create First Category
        </a>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
